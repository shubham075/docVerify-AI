# ==============================================================================
# DocVerify AI - Backend Environment Template
# Copy this file to .env and adjust variables as needed
# ==============================================================================

PROJECT_NAME="DocVerify AI"
ENVIRONMENT="development"
DEBUG=true

# Server Host, Port & Public Base URL
HOST="127.0.0.1"
PORT=8000
BASE_URL="http://127.0.0.1:8000"
API_V1_STR="/api/v1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]

# Upload Limits
MAX_SINGLE_FILE_SIZE_MB=15
MAX_FILES_PER_BULK_UPLOAD=25
MAX_TOTAL_BULK_PAYLOAD_MB=150
MAX_PDF_PAGES_CHECKED=10

TEMP_UPLOAD_DIR="temp_uploads"
